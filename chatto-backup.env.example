# Install as /etc/chatto/backup.env, owned by root:root and mode 0644.
# This file contains deployment identifiers only; do not put credentials or
# the Chatto backup passphrase here.
CHATTO_S3_BUCKET=GLOBALLY_UNIQUE_BUCKET_NAME
CHATTO_BACKUP_PREFIX=chatto/backups
CHATTO_AWS_REGION=AWS_REGION
CHATTO_AWS_ACCOUNT_ID=123456789012
CHATTO_SNS_TOPIC_ARN=arn:aws:sns:AWS_REGION:123456789012:chatto-operations
