# Install as /etc/chatto/backup.env, owned by root:root and mode 0644.
# This file contains deployment identifiers only; do not put credentials or
# the Chatto backup passphrase here.
# The @...@ tokens are placeholders replaced by the runbook's guarded sed;
# they deliberately never collide with the variable names on their left.
CHATTO_S3_BUCKET=@CHATTO_S3_BUCKET@
CHATTO_BACKUP_PREFIX=@CHATTO_BACKUP_PREFIX@
CHATTO_AWS_REGION=@CHATTO_AWS_REGION@
CHATTO_AWS_ACCOUNT_ID=@CHATTO_AWS_ACCOUNT_ID@
CHATTO_SNS_TOPIC_ARN=arn:aws:sns:@CHATTO_AWS_REGION@:@CHATTO_AWS_ACCOUNT_ID@:chatto-operations
