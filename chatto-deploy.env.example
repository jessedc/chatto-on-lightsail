# Copy to chatto-deploy.env and replace every value.
# Values are literal text, not shell syntax. Do not add quotes.
CHAT_HOST=chat.example.com

# The Lightsail instance name and its attached static IPv4 address, recorded
# when the instance is created.
LIGHTSAIL_INSTANCE_NAME=replace-with-instance-name
LIGHTSAIL_STATIC_IP=replace-with-static-ip

ACME_CONTACT_EMAIL=operator@example.com
OWNER_LOGIN=chatadmin
OWNER_DISPLAY_NAME=Chatto Owner
CHATTO_VERSION=v0.4.14

# CHATTO_AWS_ACCOUNT_ID and CHATTO_SNS_TOPIC_ARN are filled by
# provision-aws.sh. Leave them blank in the initial input file.
CHATTO_AWS_ACCOUNT_ID=
CHATTO_AWS_REGION=us-west-2
CHATTO_S3_BUCKET=replace-with-a-globally-unique-bucket-name
CHATTO_BACKUP_PREFIX=chatto/backups
CHATTO_SNS_TOPIC_ARN=
CHATTO_ALERT_EMAIL=operator@example.com
CHATTO_SES_DOMAIN=jessedc.dev
CHATTO_SMTP_FROM=noreply@jessedc.dev

# Machine name on the tailnet (its MagicDNS name). A blank value defaults to
# chatto.
TAILSCALE_HOSTNAME=chatto
